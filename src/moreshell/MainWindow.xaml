<Page x:Class="moreshell.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="moreshell - Multi-Shell Terminal (L2)" Height="600" Width="800"
      KeyDown="Window_KeyDown">
    <Grid>
        <ScrollViewer x:Name="OutputScroll" Margin="5">
            <TextBox x:Name="OutputTextBox"
                     IsReadOnly="True"
                     IsUndoEnabled="False"
                     Background="Black"
                     Foreground="LightGreen"
                     FontFamily="Consolas"
                     FontSize="13"
                     VerticalScrollBarVisibility="Auto"/>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="0,1,0,0">
            <Grid Margin="5">
                <TextBlock x:Name="StatusBar"
                           Text="Shell: cmd  |  Dir: C:\Users"
                           FontSize="10"
                           Foreground="Gray"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>
                <TextBox x:Name="InputTextBox"
                         Grid.Row="1"
                         Height="28"
                         Margin="0,28,0,0"
                         KeyDown="InputTextBox_KeyDown"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>